<control:WindowControl x:Class="PDF_Editor.Source.Views.MainWindowView"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:icon="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
		xmlns:viewModel="clr-namespace:PDF_Editor.Source.ViewModels"
		xmlns:control="clr-namespace:PDF_Editor.Source.Controls"
		Style="{StaticResource ResourceKey=MainWindow}" WindowState="{Binding Path=MainWindowState}">
	<control:WindowControl.DataContext>
		<viewModel:MainWindowViewModel/>
	</control:WindowControl.DataContext>
	<control:WindowControl.InputBindings>
		<KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding Path=EditBrowseCommandAsync}"/>
		<KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding Path=EditSaveAsCommandAsync}"/>
		<KeyBinding Key="Up" Modifiers="Ctrl+Alt" Command="{Binding Path=MainWindowHomeCommand}"/>
		<KeyBinding Key="Up" Modifiers="Alt" Command="{Binding Path=MainWindowPageBackCommand}"/>
		<KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding Path=MainWindowRefreshCommandAsync}"/>
		<KeyBinding Key="S" Modifiers="Ctrl+Alt" Command="{Binding Path=SidepanelCollapseCommand}"/>
		<KeyBinding Key="P" Modifiers="Ctrl" Command="{Binding Path=ToolbarPageViewCommand}"/>
		<KeyBinding Key="H" Modifiers="Ctrl" Command="{Binding Path=ToolbarFitToHeightCommand}"/>
		<KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding Path=ToolbarFitToWidthCommand}"/>
		<KeyBinding Key="D0" Modifiers="Ctrl" Command="{Binding Path=ToolbarResetZoomCommand}"/>
		<KeyBinding Key="NumPad0" Modifiers="Ctrl" Command="{Binding Path=ToolbarResetZoomCommand}"/>
		<KeyBinding Key="OemMinus" Modifiers="Ctrl" Command="{Binding Path=ToolbarZoomOutCommand}"/>
		<KeyBinding Key="Subtract" Modifiers="Ctrl" Command="{Binding Path=ToolbarZoomOutCommand}"/>
		<KeyBinding Key="OemPlus" Modifiers="Ctrl+Shift" Command="{Binding Path=ToolbarZoomInCommand}"/>
		<KeyBinding Key="Add" Modifiers="Ctrl" Command="{Binding Path=ToolbarZoomInCommand}"/>
		<KeyBinding Key="Left" Modifiers="Alt" Command="{Binding Path=ToolbarPreviousPageCommand}"/>
		<KeyBinding Key="Right" Modifiers="Alt" Command="{Binding Path=ToolbarNextPageCommand}"/>
		<KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding Path=ToolbarFindCommand}"/>
		<KeyBinding Key="B" Modifiers="Ctrl" Command="{Binding Path=ToolbarContentsCommand}"/>
		<KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding Path=ToolbarThumbnailsCommand}"/>
		<KeyBinding Key="I" Modifiers="Ctrl" Command="{Binding Path=ToolbarDocumentInformationCommand}"/>
		<KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding Path=MainWindowSetPageCommand}" CommandParameter="1"/>
		<KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding Path=MainWindowSetPageCommand}" CommandParameter="2"/>
		<KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding Path=MainWindowSetPageCommand}" CommandParameter="3"/>
		<KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding Path=MainWindowSetPageCommand}" CommandParameter="4"/>
		<KeyBinding Key="NumPad1" Modifiers="Ctrl" Command="{Binding Path=MainWindowSetPageCommand}" CommandParameter="1"/>
		<KeyBinding Key="NumPad2" Modifiers="Ctrl" Command="{Binding Path=MainWindowSetPageCommand}" CommandParameter="2"/>
		<KeyBinding Key="NumPad3" Modifiers="Ctrl" Command="{Binding Path=MainWindowSetPageCommand}" CommandParameter="3"/>
		<KeyBinding Key="NumPad4" Modifiers="Ctrl" Command="{Binding Path=MainWindowSetPageCommand}" CommandParameter="4"/>
		<KeyBinding Key="D1" Modifiers="Ctrl+Alt" Command="{Binding Path=HomeChangePageCommandAsync}" CommandParameter="1"/>
		<KeyBinding Key="D2" Modifiers="Ctrl+Alt" Command="{Binding Path=HomeChangePageCommandAsync}" CommandParameter="2"/>
		<KeyBinding Key="D3" Modifiers="Ctrl+Alt" Command="{Binding Path=HomeChangePageCommandAsync}" CommandParameter="3"/>
		<KeyBinding Key="D4" Modifiers="Ctrl+Alt" Command="{Binding Path=HomeChangePageCommandAsync}" CommandParameter="4"/>
		<KeyBinding Key="D5" Modifiers="Ctrl+Alt" Command="{Binding Path=HomeChangePageCommandAsync}" CommandParameter="5"/>
		<KeyBinding Key="D6" Modifiers="Ctrl+Alt" Command="{Binding Path=HomeChangePageCommandAsync}" CommandParameter="6"/>
		<KeyBinding Key="D7" Modifiers="Ctrl+Alt" Command="{Binding Path=HomeChangePageCommandAsync}" CommandParameter="7"/>
	</control:WindowControl.InputBindings>
	<control:WindowControl.Title>
		<MultiBinding Converter="{StaticResource ResourceKey=MainWindowTitle}">
			<Binding Path="PageCurrentPage"/>
			<Binding Path="HomeCurrentPage"/>
			<Binding Path="PageCurrentPDF"/>
			<Binding Path="PageCurrentDocumentsPath"/>
			<Binding Path="PageCurrentDesktopPath"/>
			<Binding Path="PageCurrentDownloadsPath"/>
		</MultiBinding>
	</control:WindowControl.Title>
	<Grid>
		<Border Padding="{Binding Path=MainWindowState, Converter={StaticResource ResourceKey=MainWindowBorderPadding}}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="1*"/>
				</Grid.ColumnDefinitions>
				<Border Grid.Column="0" Style="{StaticResource ResourceKey=SidepanelBorder}" Width="{Binding Path=SidepanelCollapsed, Converter={StaticResource ResourceKey=SidepanelWidth}}">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="75"/>
							<RowDefinition Height="7.5"/>
							<RowDefinition Height="40"/>
							<RowDefinition Height="40"/>
							<RowDefinition Height="40"/>
							<RowDefinition Height="40"/>
							<RowDefinition Height="40"/>
							<RowDefinition Height="7.5"/>
							<RowDefinition Height="1*"/>
							<RowDefinition Height="7.5"/>
							<RowDefinition Height="40"/>
						</Grid.RowDefinitions>
						<TextBlock Grid.Row="0" Style="{StaticResource ResourceKey=SidepanelTitleTextBlock}" Visibility="{Binding Path=SidepanelCollapsed, Converter={StaticResource ResourceKey=GeneralBoolToVisibility}, ConverterParameter=invert}" Text="PDF Editor"/>
						<StackPanel Grid.Row="0" Style="{StaticResource ResourceKey=SidePanelTitleStackPanel}" Visibility="{Binding Path=SidepanelCollapsed, Converter={StaticResource ResourceKey=GeneralBoolToVisibility}}">
							<TextBlock Style="{StaticResource ResourceKey=SidepanelTitleTextBlock}" Text="PDF"/>
							<TextBlock Style="{StaticResource ResourceKey=SidepanelTitleTextBlock}" Text="Editor"/>
						</StackPanel>
						<Rectangle Grid.Row="1" Style="{StaticResource ResourceKey=SidepanelRectangle}"/>
						<Border Grid.Row="2" Style="{StaticResource ResourceKey=SidepanelButtonBorder}">
							<ToggleButton Style="{StaticResource ResourceKey=SidepanelToggleButton}" IsChecked="{Binding Path=PageCurrentPage, Converter={StaticResource ResourceKey=GeneralIntToBool}, ConverterParameter=1}" Command="{Binding Path=SidepanelFolderCommand}" ContentStringFormat="Home" ToolTip="Home (Ctrl + 1)">
								<icon:IconBlock Style="{StaticResource ResourceKey=SidepanelIcon}" Icon="Home"/>
							</ToggleButton>
						</Border>
						<Border Grid.Row="3" Style="{StaticResource ResourceKey=SidepanelButtonBorder}">
							<ToggleButton Style="{StaticResource ResourceKey=SidepanelToggleButton}" IsChecked="{Binding Path=PageCurrentPage, Converter={StaticResource ResourceKey=GeneralIntToBool}, ConverterParameter=2}" Command="{Binding Path=SidepanelFolderCommand}" ContentStringFormat="Documents" ToolTip="Documents (Ctrl + 2)">
								<icon:IconBlock Style="{StaticResource ResourceKey=SidepanelIcon}" Icon="FileAlt"/>
							</ToggleButton>
						</Border>
						<Border Grid.Row="4" Style="{StaticResource ResourceKey=SidepanelButtonBorder}">
							<ToggleButton Style="{StaticResource ResourceKey=SidepanelToggleButton}" IsChecked="{Binding Path=PageCurrentPage, Converter={StaticResource ResourceKey=GeneralIntToBool}, ConverterParameter=3}" Command="{Binding Path=SidepanelFolderCommand}" ContentStringFormat="Desktop" ToolTip="Desktop (Ctrl + 3)">
								<icon:IconBlock Style="{StaticResource ResourceKey=SidepanelIcon}" Icon="Desktop"/>
							</ToggleButton>
						</Border>
						<Border Grid.Row="5" Style="{StaticResource ResourceKey=SidepanelButtonBorder}">
							<ToggleButton Style="{StaticResource ResourceKey=SidepanelToggleButton}" IsChecked="{Binding Path=PageCurrentPage, Converter={StaticResource ResourceKey=GeneralIntToBool}, ConverterParameter=4}" Command="{Binding Path=SidepanelFolderCommand}" ContentStringFormat="Downloads" ToolTip="Downloads (Ctrl + 4)">
								<icon:IconBlock Style="{StaticResource ResourceKey=SidepanelIcon}" Icon="Download"/>
							</ToggleButton>
						</Border>
						<Border Grid.Row="6" Style="{StaticResource ResourceKey=SidepanelButtonBorder}">
							<Button Style="{StaticResource ResourceKey=SidepanelButton}" Command="{Binding Path=SidepanelBrowseCommandAsync}" ContentStringFormat="Browse" ToolTip="Browse (Ctrl + O)">
								<icon:IconBlock Style="{StaticResource ResourceKey=SidepanelIcon}" Icon="FolderOpen"/>
							</Button>
						</Border>
						<Rectangle Grid.Row="7" Style="{StaticResource ResourceKey=SidepanelRectangle}"/>
						<ScrollViewer Grid.Row="8" Style="{StaticResource ResourceKey=SidepanelScrollViewer}">
							<ItemsControl ItemsSource="{Binding Path=SidepanelFileList}" ItemTemplate="{StaticResource ResourceKey=SidepanelDataTemplate}"/>
						</ScrollViewer>
						<Rectangle Grid.Row="9" Style="{StaticResource ResourceKey=SidepanelRectangle}"/>
						<Border Grid.Row="10" Style="{StaticResource ResourceKey=SidepanelCollapseButtonBorder}">
							<ToggleButton Style="{StaticResource ResourceKey=SidepanelCollapseButton}" IsChecked="{Binding Path=SidepanelCollapsed}" ToolTip="{Binding Path=SidepanelCollapsed, Converter={StaticResource ResourceKey=SidepanelCollapseButtonToolTip}}"/>
						</Border>
					</Grid>
				</Border>
				<Grid Grid.Column="1">
					<Grid.RowDefinitions>
						<RowDefinition Height="30"/>
						<RowDefinition Height="1*"/>
					</Grid.RowDefinitions>
					<Grid Grid.Row="0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="1*"/>
							<ColumnDefinition Width="50"/>
							<ColumnDefinition Width="50"/>
							<ColumnDefinition Width="50"/>
						</Grid.ColumnDefinitions>
						<Border Grid.Column="0" Style="{StaticResource ResourceKey=MainWindowTitleBarButtonBorder}" Visibility="{Binding Path=PageCurrentPage, Converter={StaticResource ResourceKey=GeneralIntToVisibility}, ConverterParameter=1.2.3.4}">
							<Button Style="{StaticResource ResourceKey=MainWindowTitleBarButton}" Command="{Binding Path=MainWindowHomeCommand}" ToolTip="Home (Ctrl + Alt + Up)">
								<Label Style="{StaticResource ResourceKey=HomeIcon}" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
							</Button>
						</Border>
						<Border Grid.Column="1" Style="{StaticResource ResourceKey=MainWindowTitleBarButtonBorder}" Visibility="{Binding Path=PageCurrentPage, Converter={StaticResource ResourceKey=GeneralIntToVisibility}, ConverterParameter=2.3.4}">
							<Button Style="{StaticResource ResourceKey=MainWindowTitleBarButton}" Command="{Binding Path=MainWindowPageBackCommand}" ToolTip="Back (Alt + Up)">
								<Label Style="{StaticResource ResourceKey=UpIcon}" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
							</Button>
						</Border>
						<Border Grid.Column="2" Style="{StaticResource ResourceKey=MainWindowTitleBarButtonBorder}" Visibility="{Binding Path=PageCurrentPage, Converter={StaticResource ResourceKey=GeneralIntToVisibility}, ConverterParameter=2.3.4}">
							<Button Style="{StaticResource ResourceKey=MainWindowTitleBarButton}" Command="{Binding Path=MainWindowRefreshCommandAsync}" ToolTip="Refresh (Ctrl + R)">
								<Label Style="{StaticResource ResourceKey=RotateRightIcon}"/>
							</Button>
						</Border>
						<TextBlock Grid.Column="3" Style="{StaticResource ResourceKey=MainWindowTitleBarTextBlock}">
							<TextBlock.Text>
								<MultiBinding Converter="{StaticResource ResourceKey=MainWindowTitleBar}">
									<Binding Path="PageCurrentPage"/>
									<Binding Path="HomeCurrentPage"/>
									<Binding Path="PageCurrentPDF"/>
									<Binding Path="PageCurrentDocumentsPath"/>
									<Binding Path="PageCurrentDesktopPath"/>
									<Binding Path="PageCurrentDownloadsPath"/>
								</MultiBinding>
							</TextBlock.Text>
							<TextBlock.ToolTip>
								<MultiBinding Converter="{StaticResource ResourceKey=MainWindowTitleBar}">
									<Binding Path="PageCurrentPage"/>
									<Binding Path="HomeCurrentPage"/>
									<Binding Path="PageCurrentPDF"/>
									<Binding Path="PageCurrentDocumentsPath"/>
									<Binding Path="PageCurrentDesktopPath"/>
									<Binding Path="PageCurrentDownloadsPath"/>
								</MultiBinding>
							</TextBlock.ToolTip>
						</TextBlock>
						<Button Grid.Column="4" Style="{StaticResource ResourceKey=WindowButton}" Command="{Binding Path=MainWindowMinimiseWindowCommand}" ToolTip="Minimise">
							<Label Style="{StaticResource ResourceKey=ZoomOutIcon}"/>
						</Button>
						<ToggleButton Grid.Column="5" Style="{StaticResource ResourceKey=MaximiseButton}" IsChecked="{Binding Path=MainWindowState, Converter={StaticResource ResourceKey=GeneralWindowStateToBool}}" ToolTip="{Binding Path=MainWindowState, Converter={StaticResource ResourceKey=MainWindowMaximiseButtonToolTip}}"/>
						<Button Grid.Column="6" Style="{StaticResource ResourceKey=WindowButton}" Command="{Binding Path=MainWindowCloseWindowCommand}" ToolTip="Close">
							<Label Style="{StaticResource ResourceKey=CloseIcon}"/>
						</Button>
					</Grid>
					<Border Grid.Row="1" Style="{StaticResource ResourceKey=MainWindowPageBorder}" Visibility="{Binding Path=PageCurrentPage, Converter={StaticResource ResourceKey=GeneralIntToVisibility}, ConverterParameter=1}">
						<Grid>
							<Grid Visibility="{Binding Path=HomeCurrentPage, Converter={StaticResource ResourceKey=GeneralIntToVisibility}, ConverterParameter=0}">
								<Grid.RowDefinitions>
									<RowDefinition Height="30"/>
									<RowDefinition Height="120"/>
									<RowDefinition Height="30"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="1*"/>
								</Grid.RowDefinitions>
								<Border Grid.Row="0" Style="{StaticResource ResourceKey=TextBlockBorder}">
									<TextBlock Style="{StaticResource ResourceKey=PopupHeadingTextBlock}" Text="PDF tools"/>
								</Border>
								<StackPanel Grid.Row="1" Style="{StaticResource ResourceKey=ToolbarLeftStackPanel}">
									<Border Style="{StaticResource ResourceKey=EditButtonBorder}">
										<Button Style="{StaticResource ResourceKey=EditButton}" Command="{Binding Path=HomeChangePageCommandAsync}" CommandParameter="1" ContentStringFormat="Merge PDF" ToolTip="Merge PDF (Ctrl + Alt + 1)">
											<icon:IconBlock Style="{StaticResource ResourceKey=EditIcon}" Icon="Copy"/>
										</Button>
									</Border>
									<Border Style="{StaticResource ResourceKey=EditButtonBorder}">
										<Button Style="{StaticResource ResourceKey=EditButton}" Command="{Binding Path=HomeChangePageCommandAsync}" CommandParameter="2" ContentStringFormat="Split PDF" ToolTip="Split PDF (Ctrl + Alt + 2)">
											<Grid>
												<icon:IconBlock Style="{StaticResource ResourceKey=EditIcon}" Icon="File"/>
												<icon:IconBlock Style="{StaticResource ResourceKey=EditIcon}" Icon="Minus"/>
											</Grid>
										</Button>
									</Border>
									<Border Style="{StaticResource ResourceKey=EditButtonBorder}">
										<Button Style="{StaticResource ResourceKey=EditButton}" Command="{Binding Path=HomeChangePageCommandAsync}" CommandParameter="3" ContentStringFormat="Extract pages" ToolTip="Extract pages (Ctrl + Alt + 3)">
											<icon:IconBlock Style="{StaticResource ResourceKey=EditIcon}" Icon="Cut"/>
										</Button>
									</Border>
									<Border Style="{StaticResource ResourceKey=EditButtonBorder}">
										<Button Style="{StaticResource ResourceKey=EditButton}" Command="{Binding Path=HomeChangePageCommandAsync}" CommandParameter="4" ContentStringFormat="Remove pages" ToolTip="Remove pages (Ctrl + Alt + 4)">
											<icon:IconBlock Style="{StaticResource ResourceKey=EditIcon}" Icon="Trash"/>
										</Button>
									</Border>
									<Border Style="{StaticResource ResourceKey=EditButtonBorder}">
										<Button Style="{StaticResource ResourceKey=EditButton}" Command="{Binding Path=HomeChangePageCommandAsync}" CommandParameter="5" ContentStringFormat="Reorder pages" ToolTip="Reorder pages (Ctrl + Alt + 5)">
											<icon:IconBlock Style="{StaticResource ResourceKey=EditIcon}" Icon="ArrowRightArrowLeft"/>
										</Button>
									</Border>
									<Border Style="{StaticResource ResourceKey=EditButtonBorder}">
										<Button Style="{StaticResource ResourceKey=EditButton}" Command="{Binding Path=HomeChangePageCommandAsync}" CommandParameter="6" ContentStringFormat="Rotate pages" ToolTip="Rotate pages (Ctrl + Alt + 6)">
											<icon:IconBlock Style="{StaticResource ResourceKey=EditIcon}" Icon="Rotate"/>
										</Button>
									</Border>
									<Border Style="{StaticResource ResourceKey=EditButtonBorder}">
										<Button Style="{StaticResource ResourceKey=EditButton}" Command="{Binding Path=HomeChangePageCommandAsync}" CommandParameter="7" ContentStringFormat="Edit properties" ToolTip="Edit properties (Ctrl + Alt + 7)">
											<icon:IconBlock Style="{StaticResource ResourceKey=EditIcon}" Icon="FileEdit"/>
										</Button>
									</Border>
								</StackPanel>
								<Border Grid.Row="2" Style="{StaticResource ResourceKey=TextBlockBorder}">
									<TextBlock Style="{StaticResource ResourceKey=PopupHeadingTextBlock}" Text="Pinned folders and files"/>
								</Border>
								<Border Grid.Row="3" Style="{StaticResource ResourceKey=TextBlockBorder}" Visibility="{Binding Path=PageEmpty, Converter={StaticResource ResourceKey=GeneralBoolToVisibility}}">
									<TextBlock Style="{StaticResource ResourceKey=PageButtonTextBlock}" Text="No pinned folders or files."/>
								</Border>
								<ScrollViewer Grid.Row="4">
									<StackPanel>
										<ItemsControl ItemsSource="{Binding Path=HomeFolderList}" ItemTemplate="{StaticResource ResourceKey=HomeFolderDataTemplate}"/>
										<ItemsControl ItemsSource="{Binding Path=HomeFileList}" ItemTemplate="{StaticResource ResourceKey=HomeFileDataTemplate}"/>
									</StackPanel>
								</ScrollViewer>
							</Grid>
							<Grid Visibility="{Binding Path=HomeCurrentPage, Converter={StaticResource ResourceKey=GeneralIntToVisibility}, ConverterParameter=1.2.3.4.5.6.7}">
								<Grid.RowDefinitions>
									<RowDefinition Height="30"/>
									<RowDefinition Height="40"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="1*"/>
								</Grid.RowDefinitions>
								<Border Grid.Row="0" Style="{StaticResource ResourceKey=TextBlockBorder}">
									<TextBlock Style="{StaticResource ResourceKey=PopupHeadingTextBlock}" Text="{Binding Path=HomeCurrentPage, Converter={StaticResource ResourceKey=EditPageTitle}}"/>
								</Border>
								<Grid Grid.Row="1">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="200"/>
										<ColumnDefinition Width="200"/>
										<ColumnDefinition Width="1*"/>
										<ColumnDefinition Width="200"/>
									</Grid.ColumnDefinitions>
									<Border Grid.Column="0" Style="{StaticResource ResourceKey=EditToolButtonBorder}">
										<Button Style="{StaticResource ResourceKey=EditFileButton}" Command="{Binding Path=EditBrowseCommandAsync}" ContentStringFormat="Browse" ToolTip="Browse (Ctrl + O)">
											<icon:IconBlock Style="{StaticResource ResourceKey=PageButtonIcon}" Icon="FolderOpen"/>
										</Button>
									</Border>
									<Border Grid.Column="1" Style="{StaticResource ResourceKey=EditToolButtonBorder}">
										<Button Style="{StaticResource ResourceKey=EditFileButton}" Command="{Binding Path=EditClearCommandAsync}" ContentStringFormat="Clear" ToolTip="Clear (Ctrl + R)">
											<icon:IconBlock Style="{StaticResource ResourceKey=PageButtonIcon}" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Icon="Remove"/>
										</Button>
									</Border>
									<Border Grid.Column="3" Style="{StaticResource ResourceKey=EditToolButtonBorder}">
										<Button Style="{StaticResource ResourceKey=EditSaveButton}" Command="{Binding Path=EditSaveAsCommandAsync}" ContentStringFormat="Save as" ToolTip="Save as (Ctrl + S)">
											<icon:IconBlock Style="{StaticResource ResourceKey=SidepanelIcon}" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Icon="Download"/>
										</Button>
									</Border>
								</Grid>
								<Grid Grid.Row="2"  Visibility="{Binding Path=HomeCurrentPage, Converter={StaticResource ResourceKey=GeneralIntToVisibility}, ConverterParameter=2.3.4.5.6.7}">
									<Border Style="{StaticResource ResourceKey=EditFileBorder}" Visibility="{Binding Path=PageEmpty, Converter={StaticResource ResourceKey=GeneralBoolToVisibility}, ConverterParameter=invert}">
										<Grid>
											<Grid.RowDefinitions>
												<RowDefinition Height="1*"/>
												<RowDefinition Height="30"/>
											</Grid.RowDefinitions>
											<Border Grid.Row="0" Style="{StaticResource ResourceKey=TextBlockBorder}">
												<TextBlock Style="{StaticResource ResourceKey=PageButtonTextBlock}" Text="{Binding Path=EditCurrentFile, Converter={StaticResource ResourceKey=SidepanelFileName}}"/>
											</Border>
											<StackPanel Grid.Row="1" Style="{StaticResource ResourceKey=ToolbarLeftStackPanel}" Visibility="{Binding Path=HomeCurrentPage, Converter={StaticResource ResourceKey=GeneralIntToVisibility}, ConverterParameter=2}">
												<TextBlock Style="{StaticResource ResourceKey=EditButtonLabelTextBlock}" Text="Split mode:"/>
												<ToggleButton Style="{StaticResource ResourceKey=EditToggleButton}" IsChecked="{Binding Path=EditSplitMode, Converter={StaticResource ResourceKey=GeneralIntToBool}, ConverterParameter=1}" Command="{Binding Path=EditChangeSplitModeCommand}" ContentStringFormat="Split every page"/>
												<ToggleButton Style="{StaticResource ResourceKey=EditToggleButton}" IsChecked="{Binding Path=EditSplitMode, Converter={StaticResource ResourceKey=GeneralIntToBool}, ConverterParameter=2}" Command="{Binding Path=EditChangeSplitModeCommand}" ContentStringFormat="Split every n pages:"/>
												<TextBox Style="{StaticResource ResourceKey=EditTextBox}" Text="{Binding Path=EditSplitEveryNPagesText, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding Path=EditSplitMode, Converter={StaticResource ResourceKey=GeneralIntToVisibility}, ConverterParameter=2}"/>
												<ToggleButton Style="{StaticResource ResourceKey=EditToggleButton}" IsChecked="{Binding Path=EditSplitMode, Converter={StaticResource ResourceKey=GeneralIntToBool}, ConverterParameter=3}" Command="{Binding Path=EditChangeSplitModeCommand}" ContentStringFormat="Split after pages:"/>
												<TextBox Style="{StaticResource ResourceKey=EditTextBox}" Text="{Binding Path=EditSplitAfterPagesText, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding Path=EditSplitMode, Converter={StaticResource ResourceKey=GeneralIntToVisibility}, ConverterParameter=3}"/>
											</StackPanel>
											<StackPanel Grid.Row="1" Style="{StaticResource ResourceKey=ToolbarLeftStackPanel}" Visibility="{Binding Path=HomeCurrentPage, Converter={StaticResource ResourceKey=GeneralIntToVisibility}, ConverterParameter=3}">
												<Button Style="{StaticResource ResourceKey=EditToolButton}" Command="{Binding Path=EditResetCommand}" ContentStringFormat="Clear selection"/>
												<TextBlock Style="{StaticResource ResourceKey=EditButtonLabelTextBlock}" Text="Extract mode:"/>
												<ToggleButton Style="{StaticResource ResourceKey=EditToggleButton}" IsChecked="{Binding Path=EditSaveAsIndividualFiles, Converter={StaticResource ResourceKey=GeneralBoolToBool}, ConverterParameter=invert}" ContentStringFormat="Save as one file"/>
												<ToggleButton Style="{StaticResource ResourceKey=EditToggleButton}" IsChecked="{Binding Path=EditSaveAsIndividualFiles, Converter={StaticResource ResourceKey=GeneralBoolToBool}}" ContentStringFormat="Save as individual files"/>
												<TextBlock Style="{StaticResource ResourceKey=EditButtonLabelTextBlock}" Text="Extract pages:"/>
												<TextBox Style="{StaticResource ResourceKey=EditTextBox}" Text="{Binding Path=EditSelectedPagesText, UpdateSourceTrigger=PropertyChanged}"/>
											</StackPanel>
											<StackPanel Grid.Row="1" Style="{StaticResource ResourceKey=ToolbarLeftStackPanel}" Visibility="{Binding Path=HomeCurrentPage, Converter={StaticResource ResourceKey=GeneralIntToVisibility}, ConverterParameter=4}">
												<Button Style="{StaticResource ResourceKey=EditToolButton}" Command="{Binding Path=EditResetCommand}" ContentStringFormat="Clear selection"/>
												<TextBlock Style="{StaticResource ResourceKey=EditButtonLabelTextBlock}" Text="Remove pages:"/>
												<TextBox Style="{StaticResource ResourceKey=EditTextBox}" Text="{Binding Path=EditSelectedPagesText, UpdateSourceTrigger=PropertyChanged}"/>
											</StackPanel>
											<StackPanel Grid.Row="1" Style="{StaticResource ResourceKey=ToolbarLeftStackPanel}" Visibility="{Binding Path=HomeCurrentPage, Converter={StaticResource ResourceKey=GeneralIntToVisibility}, ConverterParameter=5}">
												<Button Style="{StaticResource ResourceKey=EditToolButton}" Command="{Binding Path=EditResetCommand}" ContentStringFormat="Reset order"/>
												<Button Style="{StaticResource ResourceKey=EditToolButton}" Command="{Binding Path=EditReverseOrderCommand}" ContentStringFormat="Reverse order"/>
											</StackPanel>
											<StackPanel Grid.Row="1" Style="{StaticResource ResourceKey=ToolbarLeftStackPanel}" Visibility="{Binding Path=HomeCurrentPage, Converter={StaticResource ResourceKey=GeneralIntToVisibility}, ConverterParameter=6}">
												<Button Style="{StaticResource ResourceKey=EditToolButton}" Command="{Binding Path=EditResetCommand}" ContentStringFormat="Reset all pages"/>
												<Button Style="{StaticResource ResourceKey=EditToolButton}" Command="{Binding Path=EditRotateAllLeftCommand}" ContentStringFormat="Rotate all left"/>
												<Button Style="{StaticResource ResourceKey=EditToolButton}" Command="{Binding Path=EditRotateAllRightCommand}" ContentStringFormat="Rotate all right"/>
												<Button Style="{StaticResource ResourceKey=EditToolButton}" Command="{Binding Path=EditClearSelectionCommand}" ContentStringFormat="Clear selection"/>
												<TextBlock Style="{StaticResource ResourceKey=EditButtonLabelTextBlock}" Text="Selected pages:"/>
												<TextBox Style="{StaticResource ResourceKey=EditTextBox}" Text="{Binding Path=EditSelectedPagesText, UpdateSourceTrigger=PropertyChanged}"/>
												<Button Style="{StaticResource ResourceKey=EditToolButton}" Command="{Binding Path=EditRotateSelectedLeftCommand}" ContentStringFormat="Rotate selected left"/>
												<Button Style="{StaticResource ResourceKey=EditToolButton}" Command="{Binding Path=EditRotateSelectedRightCommand}" ContentStringFormat="Rotate selected right"/>
											</StackPanel>
											<StackPanel Grid.Row="1" Style="{StaticResource ResourceKey=ToolbarLeftStackPanel}" Visibility="{Binding Path=HomeCurrentPage, Converter={StaticResource ResourceKey=GeneralIntToVisibility}, ConverterParameter=7}">
												<Button Style="{StaticResource ResourceKey=EditToolButton}" Command="{Binding Path=EditResetCommand}" ContentStringFormat="Reset properties"/>
											</StackPanel>
										</Grid>
									</Border>
								</Grid>
								<Grid Grid.Row="3" Visibility="{Binding Path=HomeCurrentPage, Converter={StaticResource ResourceKey=GeneralIntToVisibility}, ConverterParameter=1}">
									<Border Style="{StaticResource ResourceKey=TextBlockBorder}" Visibility="{Binding Path=PageEmpty, Converter={StaticResource ResourceKey=GeneralBoolToVisibility}}">
										<TextBlock Style="{StaticResource ResourceKey=PageButtonTextBlock}" Text="No .pdf files selected."/>
									</Border>
								</Grid>
								<Grid Grid.Row="3" Visibility="{Binding Path=HomeCurrentPage, Converter={StaticResource ResourceKey=GeneralIntToVisibility}, ConverterParameter=2.3.4.5.6.7}">
									<Border Style="{StaticResource ResourceKey=TextBlockBorder}" Visibility="{Binding Path=PageEmpty, Converter={StaticResource ResourceKey=GeneralBoolToVisibility}}">
										<TextBlock Style="{StaticResource ResourceKey=PageButtonTextBlock}" Text="No .pdf file selected."/>
									</Border>
								</Grid>
								<ScrollViewer Grid.Row="4" Visibility="{Binding Path=PageEmpty, Converter={StaticResource ResourceKey=GeneralBoolToVisibility}, ConverterParameter=invert}">
									<Grid>
										<ItemsControl ItemsSource="{Binding Path=EditCurrentFiles}" ItemTemplate="{StaticResource ResourceKey=EditMergePDFDataTemplate}" Visibility="{Binding Path=HomeCurrentPage, Converter={StaticResource ResourceKey=GeneralIntToVisibility}, ConverterParameter=1}"/>
										<ItemsControl Style="{StaticResource ResourceKey=EditPagesItemsControl}" ItemsSource="{Binding Path=EditCurrentPages}" ItemTemplate="{StaticResource ResourceKey=EditSplitPDFDataTemplate}" Visibility="{Binding Path=HomeCurrentPage, Converter={StaticResource ResourceKey=GeneralIntToVisibility}, ConverterParameter=2}"/>
