	<Style TargetType="Button" x:Key="PageButton" BasedOn="{StaticResource ResourceKey=DefaultButton}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Style="{StaticResource ResourceKey=ButtonPaddingBorder}" Background="{TemplateBinding Property=Background}">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="40"/>
								<ColumnDefinition Width="1*"/>
							</Grid.ColumnDefinitions>
							<ContentPresenter Grid.Column="0"/>
							<TextBlock Grid.Column="1" Style="{StaticResource ResourceKey=PageButtonTextBlock}" Text="{TemplateBinding Property=ContentStringFormat, Converter={StaticResource ResourceKey=SidepanelFileName}}"/>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Background" Value="{StaticResource ResourceKey=LightGrey}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style TargetType="Button" x:Key="PageSearchButton" BasedOn="{StaticResource ResourceKey=DefaultButton}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Style="{StaticResource ResourceKey=ButtonPaddingBorder}" Background="{TemplateBinding Property=Background}">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="40"/>
								<ColumnDefinition Width="1*"/>
							</Grid.ColumnDefinitions>
							<ContentPresenter Grid.Column="0"/>
							<StackPanel Grid.Column="1">
								<TextBlock Style="{StaticResource ResourceKey=PageButtonTextBlock}" Text="{TemplateBinding Property=ContentStringFormat, Converter={StaticResource ResourceKey=SidepanelFileName}}"/>
								<TextBlock Style="{StaticResource ResourceKey=PageButtonSubtitleTextBlock}" Text="{TemplateBinding Property=ContentStringFormat, Converter={StaticResource ResourceKey=PageSearchFilePath}}"/>
							</StackPanel>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Background" Value="{StaticResource ResourceKey=LightGrey}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style TargetType="Button" x:Key="PopupButton" BasedOn="{StaticResource ResourceKey=DefaultButton}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Style="{StaticResource ResourceKey=ButtonRoundedCornersBorder}" Background="{TemplateBinding Property=Background}">
						<ContentPresenter/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Background" Value="{StaticResource ResourceKey=LightGrey}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style TargetType="Button" x:Key="SearchBoxButton" BasedOn="{StaticResource ResourceKey=DefaultButton}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Background="{TemplateBinding Property=Background}">
						<Label Style="{StaticResource ResourceKey=CloseIcon}" Foreground="{TemplateBinding Property=Foreground}"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Background" Value="{StaticResource ResourceKey=LightGrey}"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{StaticResource ResourceKey=LightGrey}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style TargetType="Button" x:Key="SidepanelButton" BasedOn="{StaticResource ResourceKey=DefaultButton}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Style="{StaticResource ResourceKey=ButtonRoundedCornersBorder}" Background="{TemplateBinding Property=Background}">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="50"/>
								<ColumnDefinition Width="1*"/>
							</Grid.ColumnDefinitions>
							<ContentPresenter Grid.Column="0"/>
							<TextBlock Grid.Column="1" Style="{StaticResource ResourceKey=SidepanelTextBlock}" Text="{TemplateBinding Property=ContentStringFormat}"/>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Background" Value="{StaticResource ResourceKey=Secondary}"/>
