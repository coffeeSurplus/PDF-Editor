	<Style TargetType="ToggleButton" x:Key="EditPageExtractToggleButton" BasedOn="{StaticResource ResourceKey=DefaultToggleButton}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ToggleButton">
					<Border Background="{TemplateBinding Property=Background}">
						<Grid>
							<ContentPresenter Name="ContentPresenter" Opacity="{TemplateBinding Property=Opacity}"/>
							<Label Name="Icon" Style="{StaticResource ResourceKey=CheckIcon}" Visibility="Collapsed"/>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="ContentPresenter" Property="Opacity" Value="0.25"/>
						</Trigger>
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="ContentPresenter" Property="Opacity" Value="0.25"/>
							<Setter TargetName="Icon" Property="Visibility" Value="Visible"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
