	<Style TargetType="Button" x:Key="ToolbarButton" BasedOn="{StaticResource ResourceKey=DefaultButton}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Style="{StaticResource ResourceKey=ButtonRoundedCornersBorder}" Background="{TemplateBinding Property=Background}">
						<ContentPresenter/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Background" Value="{StaticResource ResourceKey=Light}"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{StaticResource ResourceKey=DarkGrey}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style TargetType="Button" x:Key="WindowButton" BasedOn="{StaticResource ResourceKey=DefaultButton}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Background="{TemplateBinding Property=Background}">
						<ContentPresenter/>
					</Border>
					<ControlTemplate.Triggers>
