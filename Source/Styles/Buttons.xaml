<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:icon="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp">
	<Style TargetType="Button" x:Key="DefaultButton">
		<Setter Property="Background" Value="{StaticResource ResourceKey=Transparent}"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Foreground" Value="{StaticResource ResourceKey=Primary}"/>
		<Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
	</Style>
	<Style TargetType="Button" x:Key="EditButton">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Background="{TemplateBinding Property=Background}">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="1*"/>
								<RowDefinition Height="20"/>
							</Grid.RowDefinitions>
							<ContentPresenter Grid.Row="0"/>
							<TextBlock Grid.Row="1" Style="{StaticResource ResourceKey=DefaultTextBlock}" Text="{TemplateBinding Property=ContentStringFormat}"/>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Background" Value="{StaticResource ResourceKey=DarkGrey}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style TargetType="Button" x:Key="EditFileButton" BasedOn="{StaticResource ResourceKey=DefaultButton}">
		<Setter Property="Background" Value="{StaticResource ResourceKey=White}"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Style="{StaticResource ResourceKey=ButtonRoundedCornersBorder}" Background="{TemplateBinding Property=Background}">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="30"/>
								<ColumnDefinition Width="1*"/>
							</Grid.ColumnDefinitions>
							<ContentPresenter Grid.Column="0"/>
							<TextBlock Grid.Column="1" Style="{StaticResource ResourceKey=EditButtonTextBlock}" Foreground="{TemplateBinding Property=Foreground}" Text="{TemplateBinding Property=ContentStringFormat}"/>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Background" Value="{StaticResource ResourceKey=LightGrey}"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{StaticResource ResourceKey=DarkGrey}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style TargetType="Button" x:Key="EditItemButton" BasedOn="{StaticResource ResourceKey=DefaultButton}">
		<Setter Property="Background" Value="{StaticResource ResourceKey=White}"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Style="{StaticResource ResourceKey=ButtonRoundedCornersBorder}" Background="{TemplateBinding Property=Background}">
						<ContentPresenter/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Background" Value="{StaticResource ResourceKey=Light}"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{StaticResource ResourceKey=DarkGrey}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style TargetType="Button" x:Key="EditSaveButton" BasedOn="{StaticResource ResourceKey=DefaultButton}">
		<Setter Property="Background" Value="{StaticResource ResourceKey=Primary}"/>
		<Setter Property="Foreground" Value="{StaticResource ResourceKey=White}"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Style="{StaticResource ResourceKey=ButtonRoundedCornersBorder}" Background="{TemplateBinding Property=Background}">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="30"/>
								<ColumnDefinition Width="1*"/>
							</Grid.ColumnDefinitions>
							<ContentPresenter Grid.Column="0"/>
							<TextBlock Grid.Column="1" Style="{StaticResource ResourceKey=SidepanelFileTextBlock}" Foreground="{TemplateBinding Property=Foreground}" Text="{TemplateBinding Property=ContentStringFormat}"/>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Background" Value="{StaticResource ResourceKey=Secondary}"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Background" Value="{StaticResource ResourceKey=White}"/>
							<Setter Property="Foreground" Value="{StaticResource ResourceKey=DarkGrey}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style TargetType="Button" x:Key="EditToolButton" BasedOn="{StaticResource ResourceKey=DefaultButton}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Background="{TemplateBinding Property=Background}">
						<TextBlock Name="TextBlock" Style="{StaticResource ResourceKey=PopupSubtitleTextBlock}" Foreground="{TemplateBinding Property=Foreground}" Text="{TemplateBinding Property=ContentStringFormat}"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="TextBlock" Property="TextDecorations" Value="Underline"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{StaticResource ResourceKey=DarkGrey}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style TargetType="Button" x:Key="MainWindowTitleBarButton" BasedOn="{StaticResource ResourceKey=DefaultButton}">
