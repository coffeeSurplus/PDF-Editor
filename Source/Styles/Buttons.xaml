	<Style TargetType="ToggleButton" x:Key="NavigationThumbnailToggleButton" BasedOn="{StaticResource ResourceKey=DefaultToggleButton}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ToggleButton">
