				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style TargetType="Button" x:Key="NavigationItemButton" BasedOn="{StaticResource ResourceKey=DefaultButton}">
		<Setter Property="Tag" Value="ContentButton"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
