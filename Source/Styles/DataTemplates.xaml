						<MenuItem Command="{Binding Path=PlacementTarget.Tag.ContextMenuOpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Header="Open in Explorer">
							<MenuItem.Icon>
								<Label Style="{StaticResource ResourceKey=ExplorerIcon}"/>
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem Command="{Binding Path=PlacementTarget.Tag.ContextMenuCopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Header="Copy path">
