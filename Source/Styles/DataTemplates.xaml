	<DataTemplate x:Key="SidepanelDataTemplate" DataType="sys:String">
		<Border Style="{StaticResource ResourceKey=SidepanelButtonBorder}">
			<ToggleButton Tag="{Binding Path=DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Style="{StaticResource ResourceKey=SidepanelFileToggleButton}" Command="{Binding Path=DataContext.SidepanelFileCommandAsync, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="{Binding}" ContentStringFormat="{Binding Converter={StaticResource ResourceKey=SidepanelFileName}}">
				<ToggleButton.IsChecked>
					<MultiBinding Converter="{StaticResource ResourceKey=SidepanelFileButton}">
						<Binding Path="DataContext.PageCurrentPage" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
						<Binding Path="DataContext.PageCurrentPDF" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
						<Binding Mode="OneWay"/>
					</MultiBinding>
				</ToggleButton.IsChecked>
				<ToggleButton.ContextMenu>
					<ContextMenu>
						<MenuItem Command="{Binding Path=PlacementTarget.Tag.ContextMenuOpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Header="Open in Explorer">
							<MenuItem.Icon>
								<Label Style="{StaticResource ResourceKey=ExplorerIcon}"/>
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem Command="{Binding Path=PlacementTarget.Tag.ContextMenuCopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Header="Copy path">
							<MenuItem.Icon>
								<Label Style="{StaticResource ResourceKey=CopyIcon}"/>
							</MenuItem.Icon>
						</MenuItem>
						<Separator/>
						<MenuItem Icon="{Binding Path=IsEnabled, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource ResourceKey=ContextMenuItemIcon}, ConverterParameter=UpIcon}" Command="{Binding Path=PlacementTarget.Tag.ContextMenuMoveUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
							<MenuItem.Header>
								<TextBlock Style="{StaticResource ResourceKey=PopupTextBlock}" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" Text="Move up"/>
							</MenuItem.Header>
						</MenuItem>
						<MenuItem Icon="{Binding Path=IsEnabled, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource ResourceKey=ContextMenuItemIcon}, ConverterParameter=DownIcon}" Command="{Binding Path=PlacementTarget.Tag.ContextMenuMoveDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
							<MenuItem.Header>
								<TextBlock Style="{StaticResource ResourceKey=PopupTextBlock}" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" Text="Move down"/>
							</MenuItem.Header>
						</MenuItem>
						<Separator/>
						<MenuItem Command="{Binding Path=PlacementTarget.Tag.ContextMenuRemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Header="Remove">
							<MenuItem.Icon>
								<Label Style="{StaticResource ResourceKey=CloseIcon}"/>
							</MenuItem.Icon>
						</MenuItem>
					</ContextMenu>
				</ToggleButton.ContextMenu>
			</ToggleButton>
		</Border>
	</DataTemplate>
	<HierarchicalDataTemplate x:Key="NavigationContentHierarchicalDataTemplate" DataType="bookmark:IPDFBookmark" ItemsSource="{Binding Path=Bookmarks}">
		<Border Style="{StaticResource ResourceKey=NavigationItemButtonBorder}">
			<Button Style="{StaticResource ResourceKey=NavigationItemButton}" Command="{Binding Path=DataContext.NavigationContentNavigateCommand, RelativeSource={RelativeSource AncestorType=control:ContentView}}" CommandParameter="{Binding}">
				<TextBlock Style="{StaticResource ResourceKey=NavigationTextBlock}" Text="{Binding Path=Text}"/>
			</Button>
		</Border>
	</HierarchicalDataTemplate>
</ResourceDictionary>