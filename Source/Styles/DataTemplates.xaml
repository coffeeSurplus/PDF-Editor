							</MenuItem.Icon>
						</MenuItem>
						<MenuItem Command="{Binding Path=PlacementTarget.Tag.ContextMenuPinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Header="Pin file">
							<MenuItem.Icon>
